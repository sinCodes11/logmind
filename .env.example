# LogMind Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=LogMind
LOG_LEVEL=INFO
DEBUG=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_generate_strong_password
REDIS_DB=0
REDIS_STREAM_NAME=logmind:logs
REDIS_CONSUMER_GROUP=logmind-workers

# PostgreSQL
# Note: Port 5433 is used to avoid conflicts with local PostgreSQL on 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=logmind
POSTGRES_PASSWORD=changeme_generate_strong_password
POSTGRES_DB=logmind

# LLM Provider (claude or oci)
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OCI Generative AI (alternative to Claude)
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_id
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# Use cohere.command-r-plus-08-2024 or cohere.command-plus-latest (alias)
OCI_GENAI_MODEL=cohere.command-r-plus-08-2024

# Sigma Rules
SIGMA_RULES_PATH=rules

# MITRE ATT&CK
MITRE_ATTACK_DATA_PATH=data/mitre/enterprise-attack.json

# Slack Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#security-alerts

# Processing
BATCH_SIZE=100
PROCESSING_INTERVAL=1.0
